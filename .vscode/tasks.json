{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/LogWatcher.Web/LogWatcher.Web.csproj",
        "--configuration", "Debug",
        "--framework", "net10.0"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/logwatcher-frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "fullstack",
        "label": "Frontend (Vite)"
      }
    },
    {
      "label": "fullstack: prepare",
      "dependsOn": ["dotnet: build", "frontend: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    }
  ]
}
