<Window x:Class="AutoLogGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NLog High-Speed Generator" Height="620" Width="640"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Log File Path -->
        <GroupBox Header="Log Configuration" Grid.Row="0" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="File Path:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtFilePath" Grid.Column="1" Text="autoLogGen/logGen.txt" 
                         Padding="5" TextChanged="TxtFilePath_TextChanged"/>
            </Grid>
        </GroupBox>

        <!-- Action 1: Loop -->
        <GroupBox Header="1. Timed Log Loop" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Interval (ms):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtLoopInterval" Text="500" Width="80" Padding="4" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnLoop" Grid.Column="2" Content="Start Loop" Click="BtnLoop_Click" Padding="8,5" FontWeight="SemiBold"/>
            </Grid>
        </GroupBox>

        <!-- Action 2: Burst -->
        <GroupBox Header="2. Log Burst (Multi-threaded)" Grid.Row="2" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lines to Burst:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtBurstLines" Text="100" Width="80" Padding="4" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnBurst" Grid.Column="2" Content="Log Burst" Click="BtnBurst_Click" Padding="8,5" FontWeight="SemiBold"/>
            </Grid>
        </GroupBox>

        <!-- Action 3: Fill File -->
        <GroupBox Header="3. Fill File to Size (Multi-threaded)" Grid.Row="3" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Target Size (MB):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtTargetMB" Text="200" Width="80" Padding="4" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnFillFile" Grid.Column="2" Content="Fill File" Click="BtnFillFile_Click" Padding="8,5" FontWeight="SemiBold"/>
            </Grid>
        </GroupBox>

        <!-- Action 4: Soak Test -->
        <GroupBox Header="4. Soak Test (unattended, bounded duration)" Grid.Row="4" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Duration (h):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSoakDurationHours" Text="24" Width="50" Padding="4" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Burst every (min):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSoakBurstEveryMin" Text="30" Width="50" Padding="4" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Roll every (min, 0=off):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSoakRollEveryMin" Text="60" Width="50" Padding="4" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Idle every (min, 0=off):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSoakIdleEveryMin" Text="120" Width="50" Padding="4" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Idle length (min):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSoakIdleDurationMin" Text="5" Width="50" Padding="4" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnSoak" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Content="Start Soak Test"
                        Click="BtnSoak_Click" Padding="8,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Status Area -->
        <Border Grid.Row="6" Background="#E0E0E0" CornerRadius="4" Padding="8">
            <TextBlock x:Name="TxtStatus" Text="Ready." Foreground="#333333" FontStyle="Italic"/>
        </Border>
    </Grid>
</Window>