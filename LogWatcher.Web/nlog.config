<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      internalLogFile="logs/internal-nlog.txt">

  <targets>
    <!-- General application log -->
    <target xsi:type="File" name="logfile"
            fileName="logs/logwatcher-${shortdate}.log"
            archiveFileName="logs/archives/logwatcher-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="14"
            archiveAboveSize="20971520"
            concurrentWrites="true"
            layout="${longdate} [${uppercase:${level}}] [${logger}] ${message} ${exception:format=tostring}" />

    <!-- Dedicated tail diagnostics (temporary — investigation of rare missing lines during live tail) -->
    <target xsi:type="File" name="taildiag"
            fileName="logs/tail-diag-${shortdate}.log"
            archiveFileName="logs/archives/tail-diag-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            archiveAboveSize="20971520"
            concurrentWrites="true"
            layout="${longdate} [${uppercase:${level}}] ${message}" />

    <target xsi:type="Console" name="console"
            layout="${longdate} ${uppercase:${level}} [${logger}] ${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- Isolate tail diagnostics into their own file; final="true" stops further processing so it
         doesn't also flood the general application log.
         minlevel="Warn": in normal operation this file stays empty; it only records genuine problems
         (REAL GAP = a line was actually lost, or ReadLinesAsync giving up). Lower to "Trace" to
         re-enable the verbose per-chunk/per-push investigation logging. -->
    <logger name="TailDiag" minlevel="Warn" writeTo="taildiag" final="true" />

    <!-- Everything else: general application log + console -->
    <logger name="*" minlevel="Info" writeTo="logfile,console" />
  </rules>
</nlog>
