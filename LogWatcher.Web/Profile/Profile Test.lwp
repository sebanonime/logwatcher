<?xml version="1.0" encoding="utf-8"?>
<Profile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>Profile Test</Name>
  <LoadingParam>testLog</LoadingParam>
  <Encoding>UTF-8</Encoding>
  <DicoHighLighting>
    <Highlighting>
      <Order>0</Order>
      <Text>test</Text>
      <ForeColorArgb>-1</ForeColorArgb>
      <BackColorArgb>0</BackColorArgb>
      <DarkForeColorArgb>-8781824</DarkForeColorArgb>
      <DarkBackColorArgb>-13736448</DarkBackColorArgb>
      <LightForeColorArgb>0</LightForeColorArgb>
      <LightBackColorArgb>0</LightBackColorArgb>
      <Bold>true</Bold>
      <HightPriority>false</HightPriority>
      <CaseSensitive>false</CaseSensitive>
      <IsRegex>false</IsRegex>
    </Highlighting>
  </DicoHighLighting>
  <DicoHiddenLog>
    <HiddenLine>
      <IsActif>true</IsActif>
      <Text>Line </Text>
      <CaseSensitive>false</CaseSensitive>
      <IsRegex>false</IsRegex>
    </HiddenLine>
  </DicoHiddenLog>
  <DicoStoredFilter>
    <StoredFilter>
      <Name>All Info</Name>
      <Filter>INFO</Filter>
      <IsRegex>false</IsRegex>
      <CaseSensitive>false</CaseSensitive>
    </StoredFilter>
  </DicoStoredFilter>
</Profile>