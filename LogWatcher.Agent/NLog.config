<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warning"
      internalLogFile="${basedir}/logs/LogWatcher.Agent.internal-nlog.txt">

  <!-- Extensions -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Targets -->
  <targets>
    <default-wrapper xsi:type="AsyncWrapper" overflowAction="Block" />

    <target xsi:type="File"
            name="logfile"
            fileName="${basedir}/logs/LogWatcher.Agent.${shortdate}.log"
            layout="${longdate}[${level:uppercase=true}]${message} ${exception:format=tostring} [${logger}]"
            archiveEvery="Day"
            maxArchiveFiles="14" />

    <!-- Verbose diagnostics for the file-watch / gRPC push path (remote-agent "no lines displayed"
         investigation). Kept permanently, same philosophy as LogWatcher.Web's "TailDiag" logger:
         cheap when quiet, just raise the rule's minlevel below if/when actively investigating. -->
    <target xsi:type="File"
            name="agentdiag"
            fileName="${basedir}/logs/agent-diag-${shortdate}.log"
            layout="${longdate}[${level:uppercase=true}]${message} ${exception:format=tostring}"
            archiveEvery="Day"
            maxArchiveFiles="7" />

    <target xsi:type="Console"
            name="logconsole"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />
  </targets>

  <!-- Rules -->
  <rules>
    <logger name="Microsoft.AspNetCore.*" maxlevel="Info" final="true" />
    <!-- AgentGrpcClient + AgentFileWatcher share this logger instance; capture Debug+ here for
         detailed push/connection diagnostics without changing the main log's normal verbosity. -->
    <logger name="LogWatcher.Agent.AgentGrpcClient" minlevel="Debug" writeTo="agentdiag" />
    <logger name="*" minlevel="Info" writeTo="logfile,logconsole" />
  </rules>
</nlog>